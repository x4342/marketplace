package templates

templ AppShell(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="htmx-config" content={ `{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"selfRequestsOnly":true}` }/>
			<title>{ title } | Private Marketplace</title>
			<link rel="stylesheet" href="/assets/app.css?v=m11"/>
			<script src="/assets/htmx.min.js" defer></script>
		</head>
		<body>
			<a class="skip-link btn" href="#main-content">Skip to content</a>
			@Topbar()
			<div class="app-layout">
				@Sidebar()
				<main id="main-content" tabindex="-1" class="app-main">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ Topbar() {
	<header class="topbar">
		<div class="brand">
			<a href="/">Private Marketplace</a>
		</div>
		<a class="discovery-link" href="/discover">Discover</a>
		<a class="account-link" href="/account">Account</a>
	</header>
}

templ Sidebar() {
	<aside class="sidebar">
		<nav aria-label="Main navigation">
			<a class="nav-link" href="/">Overview</a>
		</nav>
	</aside>
}

templ PageHeader(title, description string) {
	<header class="page-header">
		<h1>{ title }</h1>
		<p>{ description }</p>
	</header>
}

templ Problem(title, message string) {
	@AppShell(title) {
		@PageHeader(title, message)
		<a class="btn btn-primary" href="/">Return to overview</a>
	}
}
