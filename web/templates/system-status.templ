package templates

type Status struct {
	DatabaseReady bool
	WorkerActive  bool
	LastHeartbeat string
}

templ SystemStatus(status Status) {
	<div id="service-status" aria-live="polite">
		<dl class="status-list">
			<div>
				<dt>Web server</dt>
				<dd>Running</dd>
			</div>
			<div>
				<dt>PostgreSQL</dt>
				if status.DatabaseReady {
					<dd>Ready</dd>
				} else {
					<dd>Unavailable</dd>
				}
			</div>
			<div>
				<dt>Background worker</dt>
				if status.WorkerActive {
					<dd>Active</dd>
				} else if status.DatabaseReady {
					<dd>No recent heartbeat</dd>
				} else {
					<dd>Status unavailable</dd>
				}
			</div>
			if status.LastHeartbeat != "" {
				<div><dt>Last heartbeat</dt><dd>{ status.LastHeartbeat }</dd></div>
			}
		</dl>
		if !status.DatabaseReady {
			<p class="status-help">Start the local PostgreSQL service and apply the migrations, then refresh.</p>
		} else if !status.WorkerActive {
			<p class="status-help">Start the local worker, then refresh.</p>
		}
	</div>
}
